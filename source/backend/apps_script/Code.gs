/* ===========================================================================
   GLIDE study backend · Google Apps Script · v5.0.0
   ---------------------------------------------------------------------------
   Deployed ONCE, by the researcher, on the study's Google account. It:
     - creates and owns the study folder on that account's Google Drive
     - keeps a registry sheet of every session
     - relays the admin device <-> participant laptop link (join codes,
       heartbeats, Stop / Withdraw / Message commands)
     - receives every file the instrument uploads, checks its SHA-256 and
       files it under participants/<child>/<mode>/<date>_<session>/

   Two keys, both generated by setup():
     ADMIN_KEY   admin console only: create sessions, list, command, delete video
     DEVICE_KEY  participant laptops: join, heartbeat, upload. Cannot list or
                 read anything back.

   SETUP (once): see SETUP_GOOGLE_DRIVE.md beside this file.
     1. script.google.com > New project > paste this file > Save
     2. Run setup() once, approve access, read the keys from the log
     3. Deploy > New deployment > Web app > Execute as: Me,
        Who has access: Anyone  > copy the /exec URL
   "Anyone" means anyone with the URL can reach the script; every request is
   then refused unless it carries one of the two keys.
   ========================================================================= */

var VERSION = "glide-backend-5.0.0";
var ROOT_NAME = "GLIDE_Study_Data";
var REG_HEADERS = ["session_id","created_at","source","mode","child_id","educator_id","join_code","capacity",
  "consent_form_version","guardian_main","guardian_gaze","guardian_video","retention_until",
  "status","last_seen","screen","progress","recording","files_uploaded","bytes_uploaded","last_upload",
  "video_deleted","withdrawn","ended_early","completed","folder_url","notes"];
var JOIN_ALPHABET = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";   // no 0/O, 1/I/L

/* ------------------------------------------------------------------ setup */
function setup() {
  var props = PropertiesService.getScriptProperties();
  var root = getOrCreateFolder_(DriveApp.getRootFolder(), ROOT_NAME);
  var reg = getOrCreateFolder_(root, "_registry");
  getOrCreateFolder_(root, "participants");
  getOrCreateFolder_(root, "_analysis");
  var docs = getOrCreateFolder_(root, "_docs");
  if (!props.getProperty("ROOT_ID")) props.setProperty("ROOT_ID", root.getId());
  if (!props.getProperty("REGISTRY_ID")) {
    var ss = SpreadsheetApp.create("GLIDE_Registry");
    var f = DriveApp.getFileById(ss.getId()); reg.addFile(f); DriveApp.getRootFolder().removeFile(f);
    var sh = ss.getSheets()[0]; sh.setName("sessions"); sh.appendRow(REG_HEADERS); sh.setFrozenRows(1);
    props.setProperty("REGISTRY_ID", ss.getId());
  }
  if (!props.getProperty("ADMIN_KEY")) props.setProperty("ADMIN_KEY", randomKey_(32));
  if (!props.getProperty("DEVICE_KEY")) props.setProperty("DEVICE_KEY", randomKey_(32));
  if (!docs.getFilesByName("README.txt").hasNext()) docs.createFile("README.txt", readme_(), MimeType.PLAIN_TEXT);
  Logger.log("GLIDE backend ready.\nRoot folder: " + root.getUrl() +
    "\nADMIN_KEY  (admin console only): " + props.getProperty("ADMIN_KEY") +
    "\nDEVICE_KEY (participant laptops): " + props.getProperty("DEVICE_KEY") +
    "\nNow: Deploy > New deployment > Web app (Execute as Me, Anyone) and copy the /exec URL.");
}
/* Run if a key may have leaked. Every laptop and the admin console then need the new key. */
function rotateKeys() {
  var p = PropertiesService.getScriptProperties();
  p.setProperty("ADMIN_KEY", randomKey_(32)); p.setProperty("DEVICE_KEY", randomKey_(32));
  Logger.log("New ADMIN_KEY: " + p.getProperty("ADMIN_KEY") + "\nNew DEVICE_KEY: " + p.getProperty("DEVICE_KEY"));
}

/* ------------------------------------------------------------------ entry */
function doGet() { return json_({ ok:true, service:"glide", version: VERSION, note:"POST only" }); }

function doPost(e) {
  var req;
  try { req = JSON.parse(e.postData.contents); } catch (x) { return json_({ ok:false, error:"bad_json" }); }
  var role = roleOf_(req.key);
  if (!role) return json_({ ok:false, error:"bad_key" });
  try {
    var op = req.op, out;
    var adminOnly = { create_session:1, list_sessions:1, status:1, command:1, folder_url:1 };
    if (adminOnly[op] && role !== "admin") return json_({ ok:false, error:"admin_key_required" });
    switch (op) {
      case "ping":           out = { role: role, version: VERSION }; break;
      case "create_session": out = createSession_(req.config || {}); break;
      case "list_sessions":  out = listSessions_(req.limit || 200); break;
      case "status":         out = { status: cacheGet_("st_" + req.session_id), commands: getCmds_(req.session_id) }; break;
      case "command":        out = addCmd_(req.session_id, req.type, req.args || {}); break;
      case "folder_url":     out = { url: root_().getUrl() }; break;
      case "join":           out = join_(req.join_code); break;
      case "heartbeat":      out = heartbeat_(req.session_id, req.status || {}); break;
      case "ack":            out = ack_(req.session_id, req.command_id); break;
      case "upload":         out = upload_(req); break;
      case "delete_video":   out = deleteVideo_(req.session || {}, req.reason || null, role); break;
      default: return json_({ ok:false, error:"unknown_op" });
    }
    out.ok = true;
    return json_(out);
  } catch (err) {
    return json_({ ok:false, error: String(err && err.message || err) });
  }
}

/* --------------------------------------------------------------- sessions */
function createSession_(c) {
  var mode = c.mode === "educator" ? "educator" : "child";
  var child = cleanCode_(c.child_id), educator = cleanCode_(c.educator_id || "");
  if (!child) throw new Error("child_id_required");
  if (!c.guardian_main) throw new Error("guardian_consent_required");
  var sid = "s" + Date.now().toString(36) + Utilities.getUuid().replace(/-/g, "").slice(0, 5);
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    var props = PropertiesService.getScriptProperties(), code;
    do { code = ""; for (var i = 0; i < 6; i++) code += JOIN_ALPHABET.charAt(Math.floor(Math.random() * JOIN_ALPHABET.length)); }
    while (props.getProperty("join_" + code));
    var date = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd");
    var folder = sessionFolder_({ child_id: child, mode: mode, date: date, session_id: sid });
    var s = { session_id: sid, join_code: code, mode: mode, child_id: child, educator_id: educator,
      capacity: c.capacity === "capable" || c.capacity === "diminished" ? c.capacity : null,
      guardian_main: !!c.guardian_main, guardian_gaze: !!c.guardian_gaze, guardian_video: !!c.guardian_video,
      consent_form_version: String(c.consent_form_version || "").slice(0, 80) || null,
      retention_until: String(c.retention_until || "").slice(0, 10) || null,
      sync_flash: c.sync_flash !== false, notes: String(c.notes || "").slice(0, 300),
      created_at: new Date().toISOString(), date: date, folder_url: folder.getUrl(), folder_id: folder.getId() };
    props.setProperty("sess_" + sid, JSON.stringify(s));
    props.setProperty("join_" + code, sid);
    regUpsert_(sid, { session_id: sid, created_at: s.created_at, source: "admin_device", mode: mode, child_id: child, educator_id: educator,
      join_code: code, capacity: s.capacity || "", consent_form_version: s.consent_form_version || "", guardian_main: s.guardian_main,
      guardian_gaze: s.guardian_gaze, guardian_video: s.guardian_video, retention_until: s.retention_until || "",
      status: "created", folder_url: s.folder_url, notes: s.notes });
    return { session: s };
  } finally { lock.releaseLock(); }
}
function join_(code) {
  code = String(code || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
  var sid = PropertiesService.getScriptProperties().getProperty("join_" + code);
  if (!sid) throw new Error("unknown_join_code");
  var s = JSON.parse(PropertiesService.getScriptProperties().getProperty("sess_" + sid));
  if (s.joined_at && (Date.now() - Date.parse(s.joined_at)) > 12 * 3600 * 1000) throw new Error("join_code_expired");
  s.joined_at = s.joined_at || new Date().toISOString();
  PropertiesService.getScriptProperties().setProperty("sess_" + sid, JSON.stringify(s));
  regUpsert_(sid, { status: "joined", last_seen: new Date().toISOString() });
  var pub = {}; ["session_id","join_code","mode","child_id","educator_id","capacity","guardian_main","guardian_gaze","guardian_video",
    "consent_form_version","retention_until","sync_flash","date","created_at"].forEach(function (k) { pub[k] = s[k]; });
  return { session: pub };
}
function heartbeat_(sid, st) {
  if (!/^s[a-z0-9]{6,30}$/.test(String(sid))) throw new Error("bad_session_id");
  st.server_seen = new Date().toISOString();
  cachePut_("st_" + sid, st);
  // The sheet is updated at most every 30 s per session (sheet writes are slow).
  var c = CacheService.getScriptCache(), k = "regw_" + sid;
  if (!c.get(k) || st.completed || st.withdrawn || st.ended_early) {
    c.put(k, "1", 30);
    regUpsert_(sid, { status: st.withdrawn ? "withdrawn" : st.completed ? "complete" : st.ended_early ? "ended_early" : "running",
      last_seen: st.server_seen, screen: st.screen_id || "", progress: (st.index || "") + "/" + (st.total || ""),
      recording: st.recording ? "yes" : (st.video_consented ? "no" : "n/a"),
      withdrawn: !!st.withdrawn, ended_early: !!st.ended_early, completed: !!st.completed, video_deleted: !!st.video_deleted });
  }
  return { commands: getCmds_(sid).filter(function (x) { return !x.acked; }) };
}
function getCmds_(sid) { var v = PropertiesService.getScriptProperties().getProperty("cmd_" + sid); return v ? JSON.parse(v) : []; }
function addCmd_(sid, type, args) {
  var ok = { stop:1, withdraw:1, message:1, delete_video:1 };
  if (!ok[type]) throw new Error("bad_command");
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    var l = getCmds_(sid); var c = { id: "c" + Date.now().toString(36) + Math.floor(Math.random() * 1e4), type: type, args: args, at: new Date().toISOString(), acked: false };
    l.push(c); PropertiesService.getScriptProperties().setProperty("cmd_" + sid, JSON.stringify(l.slice(-30)));
    return { command: c };
  } finally { lock.releaseLock(); }
}
function ack_(sid, id) {
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    var l = getCmds_(sid); l.forEach(function (c) { if (c.id === id) { c.acked = true; c.acked_at = new Date().toISOString(); } });
    PropertiesService.getScriptProperties().setProperty("cmd_" + sid, JSON.stringify(l));
    return {};
  } finally { lock.releaseLock(); }
}
function listSessions_(limit) {
  var sh = reg_(), vals = sh.getDataRange().getValues(), head = vals[0], rows = [];
  for (var i = vals.length - 1; i >= 1 && rows.length < limit; i--) {
    var o = {}; head.forEach(function (h, j) { o[h] = vals[i][j] instanceof Date ? vals[i][j].toISOString() : vals[i][j]; });
    o.live = cacheGet_("st_" + o.session_id);
    rows.push(o);
  }
  return { sessions: rows, root_url: root_().getUrl() };
}

/* ----------------------------------------------------------------- upload */
function upload_(req) {
  var m = req.session || {};
  var path = String(req.path || "");
  if (!/^[A-Za-z0-9_.\-]+(\/[A-Za-z0-9_.\-]+)?$/.test(path) || path.indexOf("..") >= 0) throw new Error("bad_path");
  var bytes = Utilities.base64Decode(req.data_b64 || "");
  if (req.size !== undefined && bytes.length !== req.size) throw new Error("size_mismatch");
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes).map(function (b) { return ((b + 256) % 256).toString(16); })
    .map(function (h) { return h.length === 1 ? "0" + h : h; }).join("");
  if (req.sha256 && req.sha256 !== digest) throw new Error("sha256_mismatch");
  var folder = sessionFolder_(m);
  var parts = path.split("/"), name = parts.pop();
  if (parts.length) folder = getOrCreateFolder_(folder, parts[0]);
  var old = folder.getFilesByName(name);
  while (old.hasNext()) old.next().setTrashed(true);       // a re-saved file replaces the earlier copy
  var file = folder.createFile(Utilities.newBlob(bytes, req.mime || "application/octet-stream", name));
  var sid = m.session_id;
  var lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    var r = regFind_(sid);
    if (!r) regUpsert_(sid, { session_id: sid, created_at: new Date().toISOString(), source: "participant_offline", mode: m.mode,
      child_id: cleanCode_(m.child_id), educator_id: cleanCode_(m.educator_id || ""), consent_form_version: m.consent_form_version || "",
      retention_until: m.retention_until || "", status: "uploading", folder_url: sessionFolder_(m).getUrl() });
    var cur = regFind_(sid);
    regUpsert_(sid, { files_uploaded: (Number(cur.files_uploaded) || 0) + 1, bytes_uploaded: (Number(cur.bytes_uploaded) || 0) + bytes.length,
      last_upload: new Date().toISOString() + " " + path });
  } finally { lock.releaseLock(); }
  return { file_id: file.getId(), sha256: digest, bytes: bytes.length };
}
/* Withdrawal "keep responses, delete video". Uses the Drive advanced service
   for a permanent delete when it is enabled (Services > Drive API); otherwise
   the parts go to the Drive trash, which empties itself after 30 days, and
   the response says so, so the admin can empty it at once. */
function deleteVideo_(m, reason, role) {
  var folder = sessionFolder_(m), it = folder.getFoldersByName("video"), n = 0, permanent = true;
  while (it.hasNext()) {
    var v = it.next(), files = v.getFiles();
    while (files.hasNext()) {
      var f = files.next();
      try { Drive.Files.remove(f.getId()); } catch (x) { f.setTrashed(true); permanent = false; }
      n++;
    }
  }
  var note = folder.createFile("VIDEO_DELETED.txt", "Video deleted " + new Date().toISOString() + " (" + n + " part files" + (permanent ? ", permanently" : ", moved to Drive trash") + "). Reason: " + (reason || "not given") + ". Requested by: " + role + ".", MimeType.PLAIN_TEXT);
  regUpsert_(m.session_id, { video_deleted: true });
  return { deleted_files: n, permanent: permanent, note_id: note.getId() };
}

/* ---------------------------------------------------------------- helpers */
function roleOf_(k) {
  var p = PropertiesService.getScriptProperties();
  if (k && k === p.getProperty("ADMIN_KEY")) return "admin";
  if (k && k === p.getProperty("DEVICE_KEY")) return "device";
  return null;
}
function root_() { return DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty("ROOT_ID")); }
function reg_() { return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty("REGISTRY_ID")).getSheetByName("sessions"); }
function cleanCode_(s) { return String(s || "").trim().replace(/[^A-Za-z0-9_\-]/g, "").slice(0, 24); }
function sessionFolder_(m) {
  var child = cleanCode_(m.child_id) || "anon", mode = m.mode === "educator" ? "educator" : m.mode === "child" ? "child" : "other";
  var date = /^\d{4}-\d{2}-\d{2}$/.test(String(m.date)) ? m.date : Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd");
  var sid = String(m.session_id || ""); if (!/^s[a-z0-9]{6,30}$/.test(sid)) throw new Error("bad_session_id");
  var p = getOrCreateFolder_(root_(), "participants");
  p = getOrCreateFolder_(p, child); p = getOrCreateFolder_(p, mode);
  return getOrCreateFolder_(p, date + "_" + sid);
}
function getOrCreateFolder_(parent, name) { var it = parent.getFoldersByName(name); return it.hasNext() ? it.next() : parent.createFolder(name); }
function regFind_(sid) {
  var sh = reg_(), vals = sh.getDataRange().getValues(), head = vals[0];
  for (var i = 1; i < vals.length; i++) if (vals[i][0] === sid) { var o = { _row: i + 1 }; head.forEach(function (h, j) { o[h] = vals[i][j]; }); return o; }
  return null;
}
function regUpsert_(sid, fields) {
  var sh = reg_(), r = regFind_(sid);
  if (!r) { var row = REG_HEADERS.map(function (h) { return fields[h] !== undefined ? fields[h] : (h === "session_id" ? sid : ""); }); sh.appendRow(row); return; }
  Object.keys(fields).forEach(function (k) { var j = REG_HEADERS.indexOf(k); if (j >= 0) sh.getRange(r._row, j + 1).setValue(fields[k]); });
}
function cachePut_(k, v) { CacheService.getScriptCache().put(k, JSON.stringify(v), 21600); }
function cacheGet_(k) { var v = CacheService.getScriptCache().get(k); return v ? JSON.parse(v) : null; }
function randomKey_(n) { var a = "abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789", s = ""; for (var i = 0; i < n; i++) s += a.charAt(Math.floor(Math.random() * a.length)); return s; }
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function readme_() {
  return "GLIDE study data\n================\n\n" +
    "participants/<child code>/<child|educator>/<YYYY-MM-DD>_<session id>/\n" +
    "  manifest.json      read first: every file with SHA-256, versions, consent form version, retention date, clock\n" +
    "  session.json       complete record\n" +
    "  responses.csv      every logged response\n  pairs.csv          one row per comparison (Bradley-Terry ready)\n" +
    "  events.csv  frames.csv  face_quality.csv  gaze.csv  gaze_zones.csv  calibration.csv  aoi.csv  pointer.csv  video_segments.csv\n" +
    "  stimuli.json  profile.json  data_dictionary.csv\n  video/part_NNN.webm  face video, no audio\n\n" +
    "_registry/GLIDE_Registry   one row per session (live status, uploads, withdrawal, video deletion)\n" +
    "_analysis/                 for merged profiles and derived datasets; never edit files under participants/\n\n" +
    "Codes only, never names. Access to this folder must stay limited to the research team named in the protocol.\n";
}
